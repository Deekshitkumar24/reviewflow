// prisma/schema.prisma — ReviewFlow v3.0
// 18 tables — Single source of truth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════
// TABLE 1: roles
// ═══════════════════════════════════════
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]
  @@map("roles")
}

// ═══════════════════════════════════════
// TABLE 2: users
// ═══════════════════════════════════════
model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  role               Role      @relation(fields: [roleId], references: [id])
  fullName           String    @map("full_name") @db.VarChar(120)
  email              String    @unique @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  status             String    @default("active") @db.VarChar(20)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  profileImageUrl    String?   @map("profile_image_url")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  createdEvents      Event[]
  reviews            Review[]
  mentorAssignments  MentorAssignment[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  labAssignments     LabAssignment[]
  checkedInTeams     Team[]   @relation("CheckedInBy")
  lockedRounds       Round[]  @relation("LockedBy")
  declaredResults    Result[]
  importBatches      ImportBatch[]

  @@index([roleId], name: "idx_users_role_id")
  @@map("users")
}

// ═══════════════════════════════════════
// TABLE 3: events
// ═══════════════════════════════════════
model Event {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName              String    @map("event_name") @db.VarChar(200)
  organizerName          String    @map("organizer_name") @db.VarChar(200)
  description            String?
  eventDate              DateTime  @map("event_date") @db.Date
  venue                  String    @db.VarChar(300)
  eventType              String    @map("event_type") @db.VarChar(30)
  status                 String    @default("draft") @db.VarChar(30)
  totalRounds            Int       @default(1) @map("total_rounds") @db.SmallInt
  suggestionsEnabled     Boolean   @default(true) @map("suggestions_enabled")
  allowMultiMentorReview Boolean   @default(false) @map("allow_multi_mentor_review")
  scoringModel           Json?     @map("scoring_model")
  createdById            String    @map("created_by") @db.Uuid
  createdBy              User      @relation(fields: [createdById], references: [id])
  deletedAt              DateTime? @map("deleted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  rounds         Round[]
  labs           Lab[]
  teams          Team[]
  results        Result[]
  eventSettings  EventSetting[]
  importBatches  ImportBatch[]

  @@map("events")
}

// ═══════════════════════════════════════
// TABLE 4: rounds
// ═══════════════════════════════════════
model Round {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  event      Event     @relation(fields: [eventId], references: [id])
  roundName  String    @map("round_name") @db.VarChar(100)
  roundOrder Int       @map("round_order") @db.SmallInt
  status     String    @default("pending") @db.VarChar(30)
  opensAt    DateTime? @map("opens_at")
  lockedAt   DateTime? @map("locked_at")
  lockedById String?   @map("locked_by") @db.Uuid
  lockedBy   User?     @relation("LockedBy", fields: [lockedById], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")

  labAssignments       LabAssignment[]
  mentorAssignments    MentorAssignment[]
  reviews              Review[]
  suggestionStatusLogs SuggestionStatusLog[]

  @@unique([eventId, roundOrder])
  @@index([eventId], name: "idx_rounds_event_id")
  @@map("rounds")
}

// ═══════════════════════════════════════
// TABLE 5: labs
// ═══════════════════════════════════════
model Lab {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  event     Event     @relation(fields: [eventId], references: [id])
  labName   String    @map("lab_name") @db.VarChar(100)
  building  String?   @db.VarChar(100)
  floor     String?   @db.VarChar(20)
  capacity  Int       @default(0) @db.SmallInt
  status    String    @default("inactive") @db.VarChar(30)
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  labAssignments    LabAssignment[]
  mentorAssignments MentorAssignment[]
  reviews           Review[]

  @@unique([eventId, labName])
  @@map("labs")
}

// ═══════════════════════════════════════
// TABLE 6: teams
// ═══════════════════════════════════════
model Team {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  event              Event     @relation(fields: [eventId], references: [id])
  teamName           String    @map("team_name") @db.VarChar(150)
  projectTitle       String    @map("project_title") @db.VarChar(250)
  projectDescription String?   @map("project_description")
  domain             String?   @db.VarChar(100)
  department         String    @db.VarChar(100)
  collegeName        String    @map("college_name") @db.VarChar(200)
  githubUrl          String?   @map("github_url")
  pptLink            String?   @map("ppt_link")
  demoLink           String?   @map("demo_link")
  attendanceStatus   String    @default("registered") @map("attendance_status") @db.VarChar(30)
  checkedInAt        DateTime? @map("checked_in_at")
  checkedInById      String?   @map("checked_in_by") @db.Uuid
  checkedInBy        User?     @relation("CheckedInBy", fields: [checkedInById], references: [id])
  importBatchId      String?   @map("import_batch_id") @db.Uuid
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  members        TeamMember[]
  labAssignments LabAssignment[]
  reviews        Review[]
  result         Result?

  @@unique([eventId, teamName])
  @@index([eventId], name: "idx_teams_event_id")
  @@map("teams")
}

// ═══════════════════════════════════════
// TABLE 7: team_members
// ═══════════════════════════════════════
model TeamMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id])
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  isLeader     Boolean  @default(false) @map("is_leader")
  academicYear Int?     @map("academic_year") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([teamId], name: "idx_team_members_team_id")
  @@map("team_members")
}

// ═══════════════════════════════════════
// TABLE 8: lab_assignments
// ═══════════════════════════════════════
model LabAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id])
  labId        String   @map("lab_id") @db.Uuid
  lab          Lab      @relation(fields: [labId], references: [id])
  roundId      String   @map("round_id") @db.Uuid
  round        Round    @relation(fields: [roundId], references: [id])
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   User     @relation(fields: [assignedById], references: [id])

  @@unique([teamId, roundId])
  @@index([roundId], name: "idx_lab_assign_round")
  @@map("lab_assignments")
}

// ═══════════════════════════════════════
// TABLE 9: mentor_assignments
// ═══════════════════════════════════════
model MentorAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId   String   @map("mentor_id") @db.Uuid
  mentor     User     @relation(fields: [mentorId], references: [id])
  labId      String   @map("lab_id") @db.Uuid
  lab        Lab      @relation(fields: [labId], references: [id])
  roundId    String   @map("round_id") @db.Uuid
  round      Round    @relation(fields: [roundId], references: [id])
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([mentorId, labId, roundId])
  @@map("mentor_assignments")
}

// ═══════════════════════════════════════
// TABLE 10: reviews
// ═══════════════════════════════════════
model Review {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId              String   @map("team_id") @db.Uuid
  team                Team     @relation(fields: [teamId], references: [id])
  mentorId            String   @map("mentor_id") @db.Uuid
  mentor              User     @relation(fields: [mentorId], references: [id])
  labId               String   @map("lab_id") @db.Uuid
  lab                 Lab      @relation(fields: [labId], references: [id])
  roundId             String   @map("round_id") @db.Uuid
  round               Round    @relation(fields: [roundId], references: [id])
  innovationScore     Int      @map("innovation_score") @db.SmallInt
  technicalScore      Int      @map("technical_score") @db.SmallInt
  presentationScore   Int      @map("presentation_score") @db.SmallInt
  feasibilityScore    Int      @map("feasibility_score") @db.SmallInt
  problemSolvingScore Int      @map("problem_solving_score") @db.SmallInt
  communicationScore  Int      @map("communication_score") @db.SmallInt
  compositeScore      Decimal  @map("composite_score") @db.Decimal(5, 2)
  strengths           String?
  weaknesses          String?
  overallComments     String?  @map("overall_comments")
  verdict             String   @db.VarChar(30)
  isDraft             Boolean  @default(false) @map("is_draft")
  reviewedAt          DateTime @default(now()) @map("reviewed_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  suggestions         Suggestion[]

  @@unique([teamId, mentorId, roundId])
  @@index([teamId, roundId], name: "idx_reviews_team_round")
  @@index([mentorId, roundId], name: "idx_reviews_mentor")
  @@map("reviews")
}

// ═══════════════════════════════════════
// TABLE 11: suggestions
// ═══════════════════════════════════════
model Suggestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId   String   @map("review_id") @db.Uuid
  review     Review   @relation(fields: [reviewId], references: [id])
  text       String
  category   String?  @db.VarChar(50)
  priority   String?  @db.VarChar(20)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")

  statusLogs SuggestionStatusLog[]

  @@index([reviewId], name: "idx_suggestions_review")
  @@map("suggestions")
}

// ═══════════════════════════════════════
// TABLE 12: suggestion_status_logs
// ═══════════════════════════════════════
model SuggestionStatusLog {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suggestionId String     @map("suggestion_id") @db.Uuid
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id])
  roundId      String     @map("round_id") @db.Uuid
  round        Round      @relation(fields: [roundId], references: [id])
  status       String     @db.VarChar(30)
  verifiedById String?    @map("verified_by") @db.Uuid
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([suggestionId, roundId])
  @@map("suggestion_status_logs")
}

// ═══════════════════════════════════════
// TABLE 13: results
// ═══════════════════════════════════════
model Result {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  event         Event     @relation(fields: [eventId], references: [id])
  teamId        String    @unique @map("team_id") @db.Uuid
  team          Team      @relation(fields: [teamId], references: [id])
  finalPosition Int?      @map("final_position")
  awardType     String?   @map("award_type") @db.VarChar(50)
  declaredById  String?   @map("declared_by") @db.Uuid
  declaredBy    User?     @relation(fields: [declaredById], references: [id])
  declaredAt    DateTime? @map("declared_at")
  isPublished   Boolean   @default(false) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([eventId, teamId])
  @@map("results")
}

// ═══════════════════════════════════════
// TABLE 14: import_batches
// ═══════════════════════════════════════
model ImportBatch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  event        Event    @relation(fields: [eventId], references: [id])
  importedById String   @map("imported_by") @db.Uuid
  importedBy   User     @relation(fields: [importedById], references: [id])
  fileName     String   @map("file_name")
  totalRows    Int      @map("total_rows")
  successRows  Int      @map("success_rows")
  failedRows   Int      @map("failed_rows")
  errorsJson   Json?    @map("errors_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("import_batches")
}

// ═══════════════════════════════════════
// TABLE 15: audit_logs (APPEND-ONLY)
// ═══════════════════════════════════════
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], name: "idx_audit_logs_entity")
  @@index([userId, createdAt(sort: Desc)], name: "idx_audit_logs_user")
  @@map("audit_logs")
}

// ═══════════════════════════════════════
// TABLE 16: notifications
// ═══════════════════════════════════════
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String    @db.VarChar(50)
  title     String
  message   String
  dataJson  Json?     @map("data_json")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead], name: "idx_notif_user_unread")
  @@map("notifications")
}

// ═══════════════════════════════════════
// TABLE 17: event_settings
// ═══════════════════════════════════════
model EventSetting {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  event     Event  @relation(fields: [eventId], references: [id])
  key       String @db.VarChar(100)
  valueJson Json   @map("value_json")

  @@unique([eventId, key])
  @@map("event_settings")
}

// ═══════════════════════════════════════
// TABLE 18: refresh_tokens
// ═══════════════════════════════════════
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  deviceInfo String?   @map("device_info")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
