# ReviewFlow v3.0 Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/reviewflow?schema=public"
# Required for running migrations via drizzle-kit (non-pooled connection)
DIRECT_URL="postgresql://user:password@localhost:5432/reviewflow_direct?schema=public"

# Auth
JWT_SECRET="your-super-secret-jwt-key-at-least-256-bits-long-change-me"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-at-least-256-bits-long-change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api/v1"

# Optional: Sentry (Error Tracking)
# SENTRY_DSN=""

# Optional: Redis (Upstash)
# REDIS_URL=""
